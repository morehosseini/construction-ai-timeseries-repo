# Licensed source data (never commit)
data/
*.xlsx
*.xls

# Generated outputs (regenerate with analysis/reproduce_paper.py)
outputs/figures/*
outputs/tables/*
outputs/*.json
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# Tabular files are only tracked in supplementary/
*.csv
!supplementary/*.csv

# Python and editor artefacts
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.vscode/
.idea/
.DS_Store
.claude/
